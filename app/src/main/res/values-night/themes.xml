<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Приложение всегда использует тёмную broadcast-тему, поэтому ночной
         вариант совпадает с основным. -->
    <style name="Base.Theme.CybersportTracker" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:colorBackground">@color/graphite</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_elevated</item>
        <item name="colorSurfaceContainerHighest">@color/surface_elevated</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOutline">@color/border</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/graphite</item>
        <item name="android:navigationBarColor">@color/graphite</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/graphite</item>
    </style>
</resources>
