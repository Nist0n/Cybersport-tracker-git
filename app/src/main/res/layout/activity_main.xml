<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/screen_subtitle"
            android:textSize="14sp" />

        <Button
            android:id="@+id/buttonLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_logout" />

        <Button
            android:id="@+id/buttonProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_profile" />

        <Button
            android:id="@+id/buttonTeams"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_teams" />

        <Button
            android:id="@+id/buttonSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_search" />

        <Button
            android:id="@+id/buttonTeamDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_team_details" />

        <Button
            android:id="@+id/buttonTournaments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_tournaments" />

        <Button
            android:id="@+id/buttonMatches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_matches" />

        <Button
            android:id="@+id/buttonFavorite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_favorite" />

        <Button
            android:id="@+id/buttonSubscribe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_subscribe" />

        <Button
            android:id="@+id/buttonPrediction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_prediction" />

        <Button
            android:id="@+id/buttonHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_history" />

        <Button
            android:id="@+id/buttonLogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_logo" />

        <TextView
            android:id="@+id/textViewResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#F0F0F0"
            android:padding="12dp"
            android:text="@string/result_hint"
            android:textIsSelectable="true"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
